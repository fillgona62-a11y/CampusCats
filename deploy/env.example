CAMPUS_BIND=127.0.0.1:8765
CAMPUS_DATA_DIR=/var/lib/campuscats
CAMPUS_MEDIA_DIR=/srv/campuscats-media
CAMPUS_ACCEL_MEDIA=1
CAMPUS_SECURE_COOKIE=1
CAMPUS_TRUST_LOCAL_PROXY=1
# 双机分离部署时填入入口机 Nginx 所在的私网地址或网段（逗号分隔）：
# CAMPUS_TRUSTED_PROXIES=127.0.0.1/8,::1/128,10.20.0.0/16

# === 高德实景校园猫地图（Web端 JS API 2.0）===
# 注意：Nginx 反代需设置 add_header Referrer-Policy strict-origin-when-cross-origin always;
# AMAP_JS_KEY=your-amap-web-js-key
# AMAP_SECURITY_CODE=your-amap-security-jscode
# 生产环境推荐通过 Nginx /_AMapService 代理转发安全密钥，留空 AMAP_SECURITY_CODE 并设置：
# AMAP_SERVICE_HOST=https://cats.school.example/_AMapService

# === 管理员账号配置（源码已移除默认密码，仅当配置环境变量时自动建号/提权）===
# CAMPUS_ADMIN_EMAIL=admin@your-campus.edu.cn
# CAMPUS_ADMIN_PASSWORD=your-strong-password-at-least-8-chars
# CAMPUS_ADMIN_NICKNAME=校园猫图鉴管理员
# CAMPUS_ADMIN_RECOVERY=optional-recovery-code
# CAMPUS_DISABLE_DEFAULT_ADMIN=1

# === 本地三模型 ONNX 视觉栈（通过 python3 deploy/install_reid_model.py 一键安装）===
# 1. DINOv2-base INT8 空间局部特征融合个体 Re-ID：
# CAMPUSCATS_ENCODER=/srv/campuscats/models/dinov2-base-q8.onnx
# CAMPUSCATS_DISTANCE=0.28
# 2. YOLOv8s 80类防人像/犬类误识 + 多猫 Soft-NMS 检测：
# CAMPUSCATS_DETECTOR=/srv/campuscats/models/yolov8s.onnx
# 3. CLIP-ViT-B/32 INT8 本地零成本 16 品种 + 11 花色 + 物种门控：
# CAMPUSCATS_CLIP_MODEL=/srv/campuscats/models/clip-vision-q8.onnx

# === 可选：云端多模态品种识别 & 猫猫助手（后台「接入 Agent」与环境变量直连均已移除 temperature/max_tokens，完美兼容 GPT-6 推理模型）===
# 方案 A：学校/中转站 OpenAI GPT 额度（如 gpt-6.2-sol / gpt-6.1-terra / gpt-4o-mini）：
# CAMPUSCATS_LLM_BASE_URL=https://api.openai.com/v1
# CAMPUSCATS_LLM_API_KEY=sk-your-school-gpt-key
# CAMPUSCATS_LLM_MODEL=gpt-6.1-terra
# CAMPUSCATS_VISION_MODEL=gpt-6.2-sol
#
# 方案 B：国内免费多模态（智谱 BigModel 免费 glm-4-flash + glm-4v-flash）：
# CAMPUSCATS_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# CAMPUSCATS_LLM_API_KEY=your-zhipu-key
# CAMPUSCATS_LLM_MODEL=glm-4-flash
# CAMPUSCATS_VISION_MODEL=glm-4v-flash
# CAMPUSCATS_LLM_TIMEOUT=30
