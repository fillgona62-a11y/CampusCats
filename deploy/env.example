CAMPUS_BIND=127.0.0.1:8765
CAMPUS_DATA_DIR=/var/lib/campuscats
CAMPUS_MEDIA_DIR=/srv/campuscats-media
CAMPUS_ACCEL_MEDIA=1
CAMPUS_SECURE_COOKIE=1

# === 可选：ONNX 视觉向量编码器（4核 4GB CPU 可流畅运行 DINOv2-small 等轻量模型）===
# CAMPUSCATS_ENCODER=/var/lib/campuscats/models/dinov2_small.onnx
# CAMPUSCATS_DISTANCE=0.22

# === 可选：多模态品种识别 & 校园猫 Agent（任意 OpenAI 兼容协议接口）===
# 通义千问 DashScope 示例：
# CAMPUSCATS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CAMPUSCATS_LLM_API_KEY=sk-your-key
# CAMPUSCATS_LLM_MODEL=qwen-plus
# CAMPUSCATS_VISION_MODEL=qwen-vl-plus
#
# DeepSeek / OpenAI 示例：
# CAMPUSCATS_LLM_BASE_URL=https://api.openai.com/v1
# CAMPUSCATS_LLM_API_KEY=sk-your-key
# CAMPUSCATS_LLM_MODEL=gpt-4o-mini
# CAMPUSCATS_VISION_MODEL=gpt-4o-mini
# CAMPUSCATS_LLM_TIMEOUT=25
